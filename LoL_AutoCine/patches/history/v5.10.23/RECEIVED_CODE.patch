+    root = tk.Tk()
+    root.withdraw()
+    try:
+        selected = filedialog.askopenfilename(
+            title="AutoCine - 参考動画のMP4を選択（キャンセルでフォルダーを選択）",
+            filetypes=[("動画", "*.mp4 *.mov *.mkv *.webm"),
+                       ("すべてのファイル", "*.*")])
+        if not selected:
+            selected = filedialog.askdirectory(title="AutoCine - 動画フォルダーを選択")
+        if not selected:
+            return None
+        return Path(selected)
+    finally:
+        root.destroy()
+
+
