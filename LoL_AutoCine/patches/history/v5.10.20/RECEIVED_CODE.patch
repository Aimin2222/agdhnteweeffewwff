diff --git a/tests/test_v51020_camera_mode_isolation.py b/tests/test_v51020_camera_mode_isolation.py
new file mode 100644
index 0000000..4638f3e
--- /dev/null
+++ b/tests/test_v51020_camera_mode_isolation.py
@@ -0,0 +1,107 @@
+# -*- coding: utf-8 -*-
+"""Mode-specific Windows visual QA fixes must not change approved camera modes."""
+from dataclasses import fields
+from pathlib import Path
+import inspect
+import math
+import pytest
+
+from core.camera import CameraPlan, RigInfo, attach_to_player
+from core.qa_plan import load_qa_plan,validate_plan
+
+
+def good_rig(h=(-0.21,-0.978)):
+    return RigInfo(mode="fps",third=True,h=h,
+                   rot={"x":0.0,"y":53.0,"z":0.0},
+                   pitch_axis="y",pitch_sign=1.0,pitch_complement=True)
+
+
+def test_camera_dataclass_abi_preserved_and_cache_isolated_by_mode():
+    assert fields(CameraPlan)[-1].name=="team"
+    src=inspect.getsource(attach_to_player)
+    assert 'cache_key = (sel, str(p.team).upper(), style)' in src
+    assert 'third_common' not in src.split("cache_key =",1)[1].split("cached =",1)[0]
+
+
+def test_blue_cinema_uses_approved_geo_aim_rotation_only_when_live_opt_in():
+    rig=good_rig()
+    cinema=CameraPlan(style="third_cinema",rig=rig,team="ORDER",
+                      third_dist=1060,third_elev=37,side_yaw=-12,kill_time=30)
+    reference=CameraPlan(style="geo_aim",rig=rig,team="ORDER",
+                         third_dist=1060,third_elev=37,side_yaw=-12,kill_time=30)
+    normal=cinema.rotation_at(30)
+    cinema._live_blue_geo_look=True
+    # Actual frame orientation now uses the same geometric convention as
+    # visually good BLUE geo #10, but camera position/zoom remain independent.
+    live=cinema.rotation_at(30)
+    assert live["z"]==0
+    assert math.isfinite(live["x"]) and math.isfinite(live["y"])
+    assert live!=normal
+    assert reference.rotation_at(30)["z"]==0
+
+
+def test_blue_normal_third_pull_back_is_opt_in():
+    plan=CameraPlan(style="third",rig=good_rig(),team="ORDER",
+                    third_dist=1060,third_elev=37,side_yaw=-12)
+    before=plan.offset_at(0.0)
+    plan._live_blue_pulled_back=True
+    after=plan.offset_at(0.0)
+    assert math.dist((0,0,0),after)>math.dist((0,0,0),before)*1.19
+
+
+def test_approved_blue_geo_aim_unchanged_by_new_flags():
+    p=CameraPlan(style="geo_aim",rig=good_rig(),team="ORDER",
+                 third_dist=1060,third_elev=37,side_yaw=-12)
+    result=p.rotation_at(20)
+    p._live_blue_geo_look=True
+    p._live_blue_pulled_back=True
+    p._live_fps_recenter=True
+    assert p.rotation_at(20)==result
+
+
+def test_approved_red_cinema_unchanged_by_blue_opt_in():
+    p=CameraPlan(style="third_cinema",rig=good_rig(),team="CHAOS",
+                 third_dist=1170,third_elev=42,side_yaw=192,kill_time=20)
+    result=p.rotation_at(20)
+    p._live_blue_geo_look=True
+    assert p.rotation_at(20)==result
+
+
+def test_fps_live_recenter_has_orientation_but_old_direct_plan_is_compatible():
+    rig=RigInfo(mode="fps",third=False,v=(-700.,1900.,-2800.))
+    p=CameraPlan(style="fps",rig=rig,team="ORDER")
+    assert p.rotation_at(1) is None
+    before=p.offset_at(1)
+    p._live_fps_recenter=True
+    assert p.rotation_at(1) is not None
+    assert math.dist((0,0,0),p.offset_at(1)) < math.dist((0,0,0),before)
+
+
+def test_curated_qa_has_one_flash_and_real_spatial_distinctions():
+    plan,source=load_qa_plan(allow_remote=False)
+    assert set(plan["montage_styles"])=={"cut","flash","dark"}
+    assert len(plan["spatial_transition_previews"])==6
+    assert "wipeleft" in plan["spatial_transition_previews"]
+    assert "slideright" in plan["spatial_transition_previews"]
+
+
+def test_simple_color_toggle_expands_adjacent_to_checkbox():
+    import tkinter as tk
+    from legacy_app import App
+    root=tk.Tk()
+    try:
+        app=App(root)
+        app.var_easy_color_custom.set(True)
+        app._update_easy_color_controls()
+        root.update_idletasks()
+        panel=app._easy_color_panel
+        assert panel.winfo_manager()=="pack"
+        # Tk's pack_info() discards the original 'after' option. Verify
+        # the actual on-screen ordering instead.
+        siblings=panel.master.pack_slaves()
+        assert siblings.index(panel)==siblings.index(app._easy_color_toggle)+1
+        app.var_easy_color_custom.set(False)
+        app._update_easy_color_controls()
+        assert not panel.winfo_manager()
+    finally:
+        root.destroy()
diff --git a/tools/reference_video_review.py b/tools/reference_video_review.py
new file mode 100644
index 0000000..721a163
--- /dev/null
+++ b/tools/reference_video_review.py
@@ -0,0 +1,112 @@
+# -*- coding: utf-8 -*-
+"""Local batch-reference review for xMedia and unviewable clip uploads.
+
+Video bytes stay on Windows. This helper writes only small JPEG contact
+sheets and JSON; never executes code from videos, downloads from the web,
+or uploads anything to GitHub. It does not perform AI character detection.
+"""
+from __future__ import annotations
+import argparse
+from io import BytesIO
+import json
+from pathlib import Path
+import re
+import subprocess
+import zipfile
+
+from PIL import Image, ImageDraw, ImageOps
+
+
+VIDEO_SUFFIXES = {".mp4", ".mov", ".mkv", ".webm"}
+SAMPLE_FRACTIONS = (0.06, 0.22, 0.38, 0.54, 0.70, 0.88)
+
+
+def sanitized_filename(name, limit=88):
+    safe = re.sub(r'[^a-zA-Z0-9_.-]+', '_', name).strip('._')
+    return (safe or 'reference')[:limit]
+
+
+def find_reference_videos(directory):
+    directory=Path(directory)
+    if not directory.is_dir():
+        raise FileNotFoundError(f"Not a video folder: {directory}")
+    return sorted(p for p in directory.rglob("*")
+                  if p.is_file() and p.suffix.lower() in VIDEO_SUFFIXES)
+
+
+def create_sheets(input_folder, output_folder, *, ffmpeg=None, logger=print):
+    from core.gpu_binary import ffmpeg_exe
+    from core.montage_fx import get_duration
+    executable=str(ffmpeg or ffmpeg_exe())
+    output=Path(output_folder)
+    output.mkdir(parents=True,exist_ok=True)
+    shots=output/"frames"
+    shots.mkdir(exist_ok=True)
+    videos=find_reference_videos(input_folder)
+    report={"schema_version":1,"video_count":len(videos),"items":[],
+            "notice":"Human/assistant visual review required; no AI tracking or upload."}
+    for index,path in enumerate(videos,1):
+        entry={"number":index,"original_name":path.name,
+               "relative_path":str(path.relative_to(input_folder)),
+               "size_bytes":path.stat().st_size,"samples":[],
+               "contact_sheet":None,"errors":[]}
+        try:
+            length=float(get_duration(path,ffmpeg=executable))
+            if not (0.2<=length<7200):
+                raise ValueError("Unsupported duration")
+            entry["duration_seconds"]=round(length,3)
+            tiles=[]
+            for sample,ratio in enumerate(SAMPLE_FRACTIONS,1):
+                second=max(0.0,min(length-.06,length*ratio))
+                command=[executable,"-nostdin","-hide_banner","-loglevel","error",
+                         "-ss",f"{second:.3f}","-i",str(path),
+                         "-frames:v","1","-vf","scale=480:270",
+                         "-f","image2pipe","-vcodec","png","-"]
+                result=subprocess.run(command,capture_output=True,timeout=40)
+                if result.returncode!=0 or not result.stdout:
+                    entry["errors"].append(f"frame {sample}: "+str(result.stderr[-200:]))
+                    continue
+                with Image.open(BytesIO(result.stdout)) as raw:
+                    img=raw.convert("RGB").copy()
+                tiles.append((img,second))
+                entry["samples"].append(round(second,2))
+            if tiles:
+                # Three columns, two rows, all frames labeled by actual time.
+                w,h,band=480,270,24
+                sheet=Image.new("RGB",(w*3,(h+band)*2),"#e6ebf2")
+                draw=ImageDraw.Draw(sheet)
+                for n,(img,second) in enumerate(tiles):
+                    x=(n%3)*w
+                    y=(n//3)*(h+band)
+                    sheet.paste(img,(x,y+band))
+                    draw.text((x+8,y+5),f"Frame {n+1} | {second:.2f} s",fill="#182338")
+                filename=f"{index:03d}_{sanitized_filename(path.stem)}.jpg"
+                destination=shots/filename
+                sheet.save(destination,quality=86,optimize=True)
+                entry["contact_sheet"]=str(destination.relative_to(output))
+                logger(f"[{index}/{len(videos)}] {path.name} -> {filename}")
+        except (OSError,ValueError,subprocess.SubprocessError) as exc:
+            entry["errors"].append(f"{type(exc).__name__}: {exc}")
+            logger(f"[{index}/{len(videos)}] Could not inspect {path.name}: {exc}")
+        report["items"].append(entry)
+        (output/"reference_review.json").write_text(json.dumps(report,ensure_ascii=False,indent=2),encoding="utf-8")
+    with zipfile.ZipFile(output/"ReferenceReview_contact_sheets.zip","w",compression=zipfile.ZIP_DEFLATED) as z:
+        z.write(output/"reference_review.json","reference_review.json")
+        for entry in report["items"]:
+            if entry["contact_sheet"]:
+                p=output/entry["contact_sheet"]
+                z.write(p,entry["contact_sheet"])
+    return output/"ReferenceReview_contact_sheets.zip"
+
+
+def main():
+    parser=argparse.ArgumentParser(description="Create contact sheets for every reference MP4")
+    parser.add_argument("input_folder",type=Path,help="Folder containing reference video clips")
+    parser.add_argument("--output",type=Path,default=Path("ReferenceReview"))
+    args=parser.parse_args()
+    out=create_sheets(args.input_folder,args.output)
+    print("Contact-sheet ZIP:",out)
+
+
+if __name__=="__main__":
+    main()
